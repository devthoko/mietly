[Unit]
Description=mietly – nächtliches Backup und WebDAV-Synchronisierung
After=postgresql.service

[Service]
Type=oneshot
User=mietly
Group=mietly
EnvironmentFile=/etc/mietly/mietly.env
WorkingDirectory=/opt/mietly/current
UMask=0077
ExecStart=/opt/mietly/current/.venv/bin/python manage.py backup --prune
ExecStartPost=-/opt/mietly/current/.venv/bin/python manage.py webdav_sync
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
