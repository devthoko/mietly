[Unit]
Description=mietly – E-Mail-Versand wiederholen
After=postgresql.service

[Service]
Type=oneshot
User=mietly
Group=mietly
EnvironmentFile=/etc/mietly/mietly.env
WorkingDirectory=/opt/mietly/current
UMask=0077
ExecStart=/opt/mietly/current/.venv/bin/python manage.py mail_retry
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
